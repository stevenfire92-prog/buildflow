{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "goals": {
      "type": "string",
      "title": "Goals"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "app",
        "website",
        "agent"
      ],
      "default": "app",
      "title": "Project type"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "building",
        "ready",
        "published"
      ],
      "default": "draft",
      "title": "Build status"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "title": "Build progress"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "deadline_alert_sent": {
      "type": "string",
      "title": "Deadline alert sent for"
    },
    "google_calendar_event_id": {
      "type": "string",
      "title": "Google Calendar event ID"
    },
    "google_calendar_synced_at": {
      "type": "string",
      "format": "date-time",
      "title": "Google Calendar synced at"
    },
    "tasks": {
      "type": "array",
      "title": "Tasks",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Task"
          },
          "done": {
            "type": "boolean",
            "default": false,
            "title": "Done"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "title": "Last activity"
    }
  },
  "required": [
    "name"
  ]
}