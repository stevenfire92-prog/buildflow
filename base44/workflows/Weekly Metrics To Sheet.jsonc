{
  "name": "Weekly Metrics To Sheet",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_metrics_to_sheet",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "export_metrics": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportWeeklyMetricsToSheet"
          },
          "then": "end",
          "x-base44": {
            "title": "Export weekly metrics to Google Sheet",
            "description": "Append summary and project snapshot rows"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/Toronto",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Appends weekly project metrics and per-project snapshots to the BuildFlow Weekly Reports Google Sheet every Monday morning"
}