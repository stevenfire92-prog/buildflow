# BuildFlow: Vercel server-side environment template
# Copy locally to .env.local or enter real values in Vercel Environment Variables.
# Never commit real credentials or prefix these secrets with VITE_.
# Use separate development/preview and production credentials.

# Real database connection URL. Current backend only checks its presence;
# database integration and owner-scoped persistence still need implementation.
DATABASE_URL=

# Real OpenAI API credential for api/ai-assistant.js.
# Independent authentication must be implemented before this route can operate.
OPENAI_API_KEY=

# Optional. Blank uses the existing code default (gpt-4o-mini).
OPENAI_MODEL=

# This template does not complete the Base44 migration.
# The current frontend still reads VITE_BASE44_APP_ID,
# VITE_BASE44_APP_BASE_URL and VITE_BASE44_FUNCTIONS_VERSION.
# Those legacy references need replacing for a Base44-free app.
# No independent Google OAuth, passkey, or Stripe server integration is
# implemented by adding environment variables alone.
